---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada — Díaz" description="La página que buscas no existe.">
  <div class="flex flex-col items-center justify-center py-20">
    <span class="font-mono text-8xl text-accent font-bold mb-6">404</span>
    <p class="text-muted text-lg mb-8">La página que buscas no existe.</p>
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-accent hover:underline text-sm transition-colors"
    >
      <span aria-hidden="true">&larr;</span> Volver al inicio
    </a>
  </div>
</Layout>
